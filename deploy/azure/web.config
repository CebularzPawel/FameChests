<?xml version="1.0" encoding="utf-8"?>
<!-- Azure App Service (Windows): IIS uruchamia scambox.exe przez HttpPlatformHandler i przekazuje mu ruch.
     Serwer sam czyta port z HTTP_PLATFORM_PORT. Ustawienia (DATABASE_URL, SECRET_KEY...) - w portalu Azure:
     Configuration -> Application settings. Opis: docs/hosting.md -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- startupTimeLimit: pierwszy start na pustej bazie wczytuje katalog kart i uzupełnia tabele - daj mu czas -->
    <httpPlatform processPath="%HOME%\site\wwwroot\scambox.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile="%HOME%\LogFiles\scambox.log"
                  startupTimeLimit="300"
                  startupRetryCount="3"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="BIND" value="127.0.0.1" />
      </environmentVariables>
    </httpPlatform>
    <!-- duże zdjęcia od admina (do 20 MB, jak limit serwera) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
